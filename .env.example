# ==========================================
# GAPAR Gestão - Exemplo de Variáveis de Ambiente
# ==========================================

# Flask Core
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=chave-secreta-forte-aleatoria-gapar

# Banco de Dados (Supabase PostgreSQL - Transaction Pooler na Porta 6543)
# Obtenha em: Supabase Dashboard -> Connect -> Transaction Pooler (Port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@[POOLER_HOST]:6543/postgres?sslmode=require

# Google OAuth 2.0
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# Administradora Inicial (Primeiro e-mail da Whitelist)
INITIAL_ADMIN_EMAIL=seu-email-google@gmail.com

# Armazenamento e Limites
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=10485760

# Fuso do abrigo (define o "dia atual" do painel Hoje e das baixas de medicação)
APP_TIMEZONE=America/Sao_Paulo

# Fotos no Supabase Storage (sem estas duas, as fotos ficam no disco local em UPLOAD_FOLDER)
# A chave service_role fica só no servidor; nunca a exponha no frontend.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=animais

# Endereco publico do app, usado na URL de retorno do Google (vazio = host da requisicao)
PUBLIC_BASE_URL=http://localhost:5173

# ==========================================
# Ampliação v5.1 — Segurança, LGPD, Anti-Bot e Feature Flags
# ==========================================

# Chaves de criptografia para dados pessoais (CPF, telefone e endereço — LGPD).
# Aceita lista separada por vírgula para rotação via MultiFernet (a 1ª cifra, todas decifram).
# Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATENCAO CRITICA: guardar backup seguro! Perder a PII_FERNET_KEYS torna os CPFs ilegíveis para sempre.
PII_FERNET_KEYS=SUBSTITUA_POR_CHAVE_FERNET_GERADA_COM_32_BYTES_BASE64

# Chave HMAC-SHA256 para busca exata (blind index) de CPF/telefone sem expor em texto claro.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
PII_HMAC_KEY=substitua-por-segredo-aleatorio-minimo-32-caracteres

# Cloudflare Turnstile (anti-bot gratuito nos formulários públicos)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Contato público da ONG para botões "Quero adotar" (somente dígitos com DDI 55, ex.: 5541999998888)
PUBLIC_WHATSAPP_ADOCAO=5500999990000

# Segredo para autenticar chamadas agendadas do Vercel Cron (/api/cron/lgpd-anonymize)
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
CRON_SECRET=substitua-por-segredo-aleatorio-para-cron

# Prazo de retenção de candidaturas recusadas/desistentes antes da anonimização (RN25)
RETENCAO_CANDIDATURA_DIAS=180

# Feature Flags (todas desligadas por padrão até a homologação de cada módulo)
FEATURE_VITRINE=false
FEATURE_ESTOQUE=false
FEATURE_MICROCHIP=false
FEATURE_ISOLAMENTO=false
FEATURE_POS_ADOCAO=false
FEATURE_TERMO_DIGITAL=false
FEATURE_CANDIDATURAS=false
FEATURE_CARTEIRA=false
FEATURE_MAPA=false
