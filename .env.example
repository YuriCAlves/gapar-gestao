# Flask
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-mude-em-producao-gapar-2026

# Database
# MySQL (Padrão de desenvolvimento e produção):
DATABASE_URL=mysql+pymysql://root:senha@localhost:3306/gapar_gestao?charset=utf8mb4

# Ou variáveis granulares:
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=sua-senha
# MYSQL_DATABASE=gapar_gestao

# SQLite (Fallback opcional para testes rápidos):
# DATABASE_URL=sqlite:///gapar.db

# Google OAuth 2.0 (Google Identity API)
GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-google-client-secret
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# Administradora Inicial (RN13)
INITIAL_ADMIN_EMAIL=admin@gapar.org.br

# Uploads
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=10485760 # 10MB limite de envio antes da compressão (<300KB)
